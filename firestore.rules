rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Players collection: Public read for live auction & player profiles
    match /players/{playerId} {
      allow read: if true;
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.mobile is string;
      allow update, delete: if true;
    }

    // Teams collection: Public read for squads and remaining purses
    match /teams/{teamId} {
      allow read: if true;
      allow write: if true;
    }

    // Fixtures collection: Tournament match schedules
    match /fixtures/{fixtureId} {
      allow read: if true;
      allow write: if true;
    }

    // Live Auction State: Real-time broadcast for live bidding
    match /auction/{auctionDocId} {
      allow read: if true;
      allow write: if true;
    }

    // Bids collection: Live stream of bids
    match /bids/{bidId} {
      allow read: if true;
      allow create: if request.resource.data.amount is number
                    && request.resource.data.teamId is string;
      allow update, delete: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
